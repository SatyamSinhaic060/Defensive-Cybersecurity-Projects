        print("[-] No IPs found to analyze. Exiting.")
        return

    print("\n--- Starting Threat Intelligence Correlation ---")
    for ip in ips_to_check:
        # Skip local/private network loopbacks
        if ip.startswith("127.0.") or ip.startswith("192.168."):
            continue
            
        print(f"[*] Checking {ip}...")
        score, country = check_ip_threat_intel(ip)
        
        # Set a threshold for generating a security alert (e.g., confidence score > 50%)
        if score >= 50:
            print(f" [CRITICAL ALERT] Malicious IP Detected!")
            print(f"   -> IP: {ip}")
            print(f"   -> Origin Country: {country}")
            print(f"   -> Abuse Confidence Score: {score}%\n")
        else:
            print(f"   -> {ip} appears clean (Score: {score}%)\n")

